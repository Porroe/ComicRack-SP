<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:cyo="http://schemas.cyolito.com/android">
    <PreferenceCategory android:title="@string/preference_category_wallpaper_looks_title" android:key="preference_category_wallpaper_looks">
        <CheckBoxPreference android:title="@string/wallpaper_parallax_title" android:key="wallpaper_parallax" android:summary="@string/wallpaper_parallax_summary" android:defaultValue="false" />
        <ListPreference android:persistent="true" android:entries="@array/wallpaperAnimation" android:title="@string/wallpaper_animation_title" android:key="wallpaper_animation" android:summary="@string/wallpaper_animation_summary" android:defaultValue="Off" android:dialogTitle="@string/wallpaper_animation_dialog_title" android:entryValues="@array/wallpaperAnimationValues" />
        <com.cyo.common.view.SeekBarPreference android:max="100" android:title="@string/wallpaper_dim_title" android:key="wallpaper_dim" android:summary="@string/wallpaper_dim_summary" android:defaultValue="0" cyo:unit="%" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/preference_category_comic_selection_title" android:key="preference_category_wallpaper_comics">
        <ListPreference android:persistent="true" android:entries="@array/autoChange" android:title="@string/comic_selection_auto_change_title" android:key="wallpaper_auto_change" android:summary="@string/comic_selection_auto_change_summary" android:defaultValue="300" android:dialogTitle="@string/comic_selection_auto_change_dialog_title" android:entryValues="@array/autoChangeValues" />
        <com.cyo.common.view.ListPreferenceMultiSelect android:persistent="true" android:entries="@array/comicSelection" android:title="@string/comic_selection_comic_selection_title" android:key="wallpaper_comic_selection" android:summary="@string/comic_selection_comic_selection_summary" android:dialogTitle="@string/comic_selection_comic_selection_dialog_title" android:entryValues="@array/comicSelectionValues" />
        <EditTextPreference android:persistent="true" android:title="@string/comic_selection_comic_keywords_title" android:key="wallpaper_comic_keywords" android:summary="@string/comic_selection_comic_keywords_summary" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/preference_category_wallpaper_controls_title" android:key="preference_category_wallpaper_controls">
        <CheckBoxPreference android:title="@string/wallpaper_tap_change_title" android:key="wallpaper_tap_change" android:summary="@string/wallpaper_tap_change_summary" android:defaultValue="false" />
        <ListPreference android:persistent="true" android:entries="@array/comicTapAction" android:title="@string/wallpaper_doubletap_title" android:key="wallpaper_doubletap" android:summary="@string/wallpaper_doubletap_summary" android:defaultValue="Read" android:dialogTitle="@string/wallpaper_doubletap_dialog_title" android:entryValues="@array/comicTapActionValues" />
    </PreferenceCategory>
</PreferenceScreen>
